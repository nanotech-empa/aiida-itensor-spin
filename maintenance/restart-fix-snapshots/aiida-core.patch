+@pytest.mark.requires_broker
+@pytest.mark.parametrize('max_iterations', (1, 2, 3))
+def test_inspect_after_max_iterations_pause_and_play(
+    generate_work_chain, generate_calculation_node, max_iterations
+):
+    """Playing a limit-paused chain must inspect the newest child, not an old one."""
+    process = generate_work_chain(
+        SomeWorkChain, {'pause_on_max_iterations': True, 'max_iterations': max_iterations}
+    )
+    process.setup()
+    process.ctx.children = []
+
+    # Exercise two approval windows: the child history must survive both resets.
+    for _ in range(2):
+        for iteration in range(1, max_iterations + 1):
+            process.ctx.children.append(generate_calculation_node(exit_status=1).store())
+            process.ctx.iteration += 1
+            result = process.inspect_process()
+            if iteration < max_iterations:
+                assert result == engine.ExitCode(0)
+                assert not process.paused
+            else:
+                assert result is None
+                assert process.paused
+                assert process.ctx.iteration == 0
+        process.play()
+        assert not process.paused
+
+    newest = generate_calculation_node(exit_status=0).store()
+    process.ctx.children.append(newest)
+    process.ctx.iteration += 1
+    assert process.inspect_process() is None
+    assert process.ctx.is_finished is True
+    assert not process.paused
+    assert len(process.ctx.children) == 2 * max_iterations + 1
+    assert process.ctx.children[-1] is newest
+
+
+@pytest.mark.requires_broker
+def test_run_process_call_label_after_iteration_reset(
+    generate_work_chain, generate_calculation_node, monkeypatch
+):
+    """Child CALL labels must not repeat when the approval-window counter resets."""
+    submitted = []
+
+    def mock_submit(_, process_class, **kwargs):
+        assert process_class is SomeWorkChain._process_class
+        submitted.append(kwargs['metadata']['call_link_label'])
+        return generate_calculation_node()
+
+    monkeypatch.setattr(SomeWorkChain, 'submit', mock_submit)
+    process = generate_work_chain(SomeWorkChain, {})
+    process.setup()
+    process.ctx.children = [generate_calculation_node()]
+    process.ctx.iteration = 0
+    assert isinstance(process.run_process(), engine.ToContext)
+    assert process.ctx.iteration == 1
+    assert submitted == ['iteration_02']
+
