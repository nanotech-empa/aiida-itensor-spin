+@pytest.mark.requires_broker
+def test_inspect_after_limit_pause_checkpoint_reload(generate_work_chain, generate_calculation_node):
+    """The latest-child fix must also survive restoration from a persisted pause."""
+    from aiida.engine.persistence import AiiDAPersister
+
+    process = generate_work_chain(SomeWorkChain, {'pause_on_max_iterations': True, 'max_iterations': 1})
+    process.setup()
+    old = generate_calculation_node(exit_status=1).store()
+    process.ctx.children = [old]
+    process.ctx.iteration = 1
+    assert process.inspect_process() is None
+    assert process.paused
+    assert process.ctx.iteration == 0
+    bundle = AiiDAPersister().load_checkpoint(process.node.pk)
+    process.close()
+
+    restored = bundle.unbundle()
+    try:
+        assert restored.paused
+        assert restored.ctx.iteration == 0
+        assert [node.uuid for node in restored.ctx.children] == [old.uuid]
+        restored.play()
+        newest = generate_calculation_node(exit_status=0).store()
+        restored.ctx.children.append(newest)
+        restored.ctx.iteration += 1
+        assert restored.inspect_process() is None
+        assert restored.ctx.is_finished is True
+        assert not restored.paused
+    finally:
+        restored.close()
+
