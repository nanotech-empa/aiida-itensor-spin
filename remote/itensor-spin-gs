#!/usr/bin/env python3
"""Daint-side driver for registered parameterized ground-state calculations."""

import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path

DEFAULT_CASE_ROOT = Path("/capstor/scratch/cscs/cpi/goncalo/parallel/aiida_spin_engine_v4")
DEFAULT_JULIA = Path("/capstor/scratch/cscs/cpi/goncalo/.julia/gh200/juliaup/bin/julia")
LEGACY_MODEL = "spin1_chain_spinhalf_impurity_v1"
MIXED_MODEL = "mixed_spin_heisenberg_chain_v1"


def model_command(parameters, case_root):
    model = parameters["model"]
    if model == LEGACY_MODEL:
        return case_root / "prepare_gs.jl", [
            "--L",
            str(parameters["length"]),
            "--impurity-site",
            str(parameters["impurity_site"]),
            "--J-meV",
            str(parameters["J_meV"]),
            "--JL-meV",
            str(parameters["JL_meV"]),
            "--JR-meV",
            str(parameters["JR_meV"]),
        ]
    if model == MIXED_MODEL:
        two_spins = [round(2 * spin) for spin in parameters["site_spins"]]
        return case_root / "prepare_mixed_spin_gs.jl", [
            "--two-spins",
            ",".join(str(value) for value in two_spins),
            "--couplings-meV",
            ",".join(str(value) for value in parameters["couplings_meV"]),
            "--target-twice-sz",
            str(parameters["target_twice_sz"]),
        ]
    raise RuntimeError(f"unsupported model: {model}")


def main():
    if len(sys.argv) != 2:
        raise RuntimeError("usage: itensor-spin-gs ground_state.json")
    started = time.time()
    config = json.loads(Path(sys.argv[1]).read_text())
    if config.get("format_version") != 1:
        raise RuntimeError("unsupported GS input format")
    parameters = config["parameters"]
    model = parameters["model"]
    length = int(parameters["length"])
    seed = int(parameters["seed"])
    threading_mode = parameters["threading_mode"]
    execution = config.get("execution", {})
    scan_only = bool(execution.get("scan_only", False))
    threads = int(os.environ.get("SLURM_CPUS_PER_TASK", "0"))
    if (
        int(os.environ.get("SLURM_NNODES", "0")) != 1
        or int(os.environ.get("SLURM_NTASKS", "0")) != 1
    ):
        raise RuntimeError("the GS wrapper requires exactly one node and one Slurm task")

    case_root = Path(os.environ.get("ITENSOR_SPIN_CASE_ROOT", DEFAULT_CASE_ROOT))
    julia = Path(os.environ.get("ITENSOR_SPIN_JULIA", DEFAULT_JULIA))
    script, model_arguments = model_command(parameters, case_root)
    if scan_only and model != MIXED_MODEL:
        raise RuntimeError("sector scan mode requires the mixed-spin model")
    environment = os.environ.copy()
    environment.update(
        {
            "JULIA_NUM_THREADS": f"{threads},0",
            "OMP_NUM_THREADS": "1",
            "OPENBLAS_NUM_THREADS": "1",
            "MKL_NUM_THREADS": "1",
            "MPICH_GPU_SUPPORT_ENABLED": "0",
        }
    )
    command = [
        "srun",
        "--exclusive",
        "--exact",
        "--nodes=1",
        "--ntasks=1",
        f"--cpus-per-task={threads}",
        "--cpu-bind=cores",
        str(julia),
        "--startup-file=no",
        f"--project={case_root / 'ITensor_env'}",
        str(script),
        "--output",
        ".",
        "--seed",
        str(seed),
        "--threading-mode",
        threading_mode,
        "--model",
        model,
        *model_arguments,
        "--dmrg-cutoff",
        str(parameters["dmrg_cutoff"]),
        "--spectral-cutoff",
        str(parameters["spectral_cutoff"]),
        "--energy-precision-meV",
        str(parameters["energy_precision_meV"]),
        "--highest-energy-precision-meV",
        str(parameters["highest_energy_precision_meV"]),
        "--initial-linkdim",
        str(parameters["initial_linkdim"]),
        "--excited-states",
        str(parameters["excited_states"]),
        "--excited-state-penalty-meV",
        str(parameters["excited_state_penalty_meV"]),
        "--temperature-K",
        str(parameters["temperature_K"]),
        "--symmetry-tolerance",
        str(parameters["symmetry_tolerance"]),
        "--omega-max-meV",
        str(parameters["omega_max_meV"]),
        "--omega-smearing-meV",
        str(parameters["omega_smearing_meV"]),
        "--try-doubleN",
        str(parameters["try_doubleN"]).lower(),
        "--scan-only",
        str(scan_only).lower(),
    ]
    with Path("gs-runtime-stdout.txt").open("w") as stdout, Path(
        "gs-runtime-stderr.txt"
    ).open("w") as stderr:
        subprocess.run(
            command,
            check=True,
            text=True,
            env=environment,
            stdout=stdout,
            stderr=stderr,
        )

    if scan_only:
        energy_fields = Path("gs_scan_energy.txt").read_text().split()
        if len(energy_fields) != 3:
            raise RuntimeError(f"invalid sector scan energy report: {energy_fields!r}")
        reported_length = int(energy_fields[0])
        reported_sector = int(energy_fields[1])
        ground_energy = float(energy_fields[2])
        if reported_length != length:
            raise RuntimeError(
                f"sector scan reports L={reported_length}, expected L={length}"
            )
        if reported_sector != int(parameters["target_twice_sz"]):
            raise RuntimeError("sector scan reports a different target 2Sz")
        status = {
            "format_version": 1,
            "state": "complete",
            "scan_only": True,
            "model": model,
            "length": length,
            "ground_states": 1,
            "total_tasks": 0,
            "ground_energy_meV": ground_energy,
            "seed": seed,
            "threading_mode": threading_mode,
            "julia_threads": threads,
            "elapsed_seconds": time.time() - started,
            "slurm_job_id": os.environ.get("SLURM_JOB_ID"),
            "site_spins": parameters["site_spins"],
            "couplings_meV": parameters["couplings_meV"],
            "target_twice_sz": parameters["target_twice_sz"],
        }
        Path("gs_status.json").write_text(
            json.dumps(status, indent=2, sort_keys=True) + "\n"
        )
        return 0

    checkpoint = Path("gs_checkpoint.jld2")
    dimensions = Path("gs_dimensions.txt").read_text().split()
    if len(dimensions) != 3:
        raise RuntimeError(f"invalid GS dimensions: {dimensions!r}")
    reported_length, ground_states, total_tasks = map(int, dimensions)
    if reported_length != length:
        raise RuntimeError(f"GS dimensions report L={reported_length}, expected L={length}")
    if ground_states < 1 or total_tasks != 3 * length * ground_states:
        raise RuntimeError("GS dimensions are inconsistent with 3 * length * ground_states")
    energy_window = Path("gs_energy_window.txt").read_text().split()
    if len(energy_window) != 3:
        raise RuntimeError(f"invalid GS energy window: {energy_window!r}")
    ground_energy, highest_energy, spectral_bandwidth = map(float, energy_window)
    if spectral_bandwidth <= 0:
        raise RuntimeError("GS spectral bandwidth must be positive")
    digest = hashlib.sha256(checkpoint.read_bytes()).hexdigest()
    status = {
        "format_version": 1,
        "state": "complete",
        "scan_only": False,
        "model": model,
        "length": length,
        "ground_states": ground_states,
        "total_tasks": total_tasks,
        "ground_energy_meV": ground_energy,
        "highest_energy_meV": highest_energy,
        "spectral_bandwidth_meV": spectral_bandwidth,
        "omega_max_meV": float(parameters["omega_max_meV"]),
        "seed": seed,
        "threading_mode": threading_mode,
        "julia_threads": threads,
        "checkpoint_bytes": checkpoint.stat().st_size,
        "checkpoint_sha256": digest,
        "elapsed_seconds": time.time() - started,
        "slurm_job_id": os.environ.get("SLURM_JOB_ID"),
    }
    if model == LEGACY_MODEL:
        status["impurity_site"] = int(parameters["impurity_site"])
    else:
        status.update(
            {
                "site_spins": parameters["site_spins"],
                "couplings_meV": parameters["couplings_meV"],
                "target_twice_sz": parameters["target_twice_sz"],
            }
        )
    Path("gs_status.json").write_text(json.dumps(status, indent=2, sort_keys=True) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
